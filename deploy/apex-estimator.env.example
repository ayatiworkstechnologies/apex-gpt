# Copy this to /etc/apex-estimator.env on the server and fill in real values.
# Loaded by the systemd unit (EnvironmentFile=-/etc/apex-estimator.env).

# Required to use POST /api/model/refresh-live (endpoint fails closed without it)
REFRESH_API_KEY=change-me-to-a-real-secret

# Leave empty for a normal deployment behind nginx at the domain root.
API_ROOT_PATH=

# Optional: route /api/estimate-from-prompt through a local Ollama LLM instead
# of the regex parser. Leave unset ("regex") unless Ollama is installed and a
# model has been pulled on this server (see README.md).
# PROMPT_PARSER=llm
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434
